# Template only. No real credentials belong in this file or in Git.
# Spring Boot does not automatically load .env files. Set these in the process environment.

# Use a NEW database, not the existing careerai_freshness database, for the first upgraded run.
DB_URL=jdbc:postgresql://localhost:5432/careerai_demo
DB_USERNAME=careerai
DB_PASSWORD=replace_with_your_database_password
PORT=8080

# Fill with real values only in your local/server secret environment.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
GEMINI_API_KEYS=replace_with_your_gemini_api_key
GROQ_API_KEY=

# Runtime defaults. Keep both false for an isolated startup against a database copy.
TELEGRAM_POLLING_ENABLED=true
CAREERAI_BACKGROUND_ENABLED=true

# Admin access is closed by default. Obtain employee user IDs via /myid privately.
ADMIN_ENABLED=false
ADMIN_TELEGRAM_USER_IDS=
# Full public HTTPS URL, for example https://career.example.org/admin/
ADMIN_PUBLIC_URL=
ADMIN_AUTH_MAX_AGE_SECONDS=3600

SEMANTIC_SEARCH_ENABLED=true
SEMANTIC_LIFECYCLE_ENABLED=true
SEMANTIC_LIFECYCLE_BATCH_SIZE=10
STANDALONE_RELATIONS_ENABLED=true
SEMANTIC_SEARCH_FAQ_MAX_RESULTS=4
SEMANTIC_SEARCH_FAQ_MIN_SIMILARITY=0.45
SEMANTIC_SEARCH_CHANNEL_MAX_RESULTS=6
SEMANTIC_SEARCH_CHANNEL_MIN_SIMILARITY=0.45
CHANNEL_POST_FRESHNESS_RECALCULATE_ON_STARTUP=false
CHANNEL_POST_FRESHNESS_SCHEDULED_RECALCULATION_ENABLED=true

# Optional Spring property overrides; bot API usage is separate from ChatGPT/Codex.
LLM_PROVIDER=GEMINI
GEMINI_API_MODEL=gemini-3.1-flash-lite
GROQ_API_MODEL=openai/gpt-oss-20b

# Integration tests only: use a disposable, separate PostgreSQL database.
CAREERAI_INTEGRATION_TESTS=false
TEST_DB_URL=jdbc:postgresql://localhost:5432/careerai_test
TEST_DB_USERNAME=careerai_test
TEST_DB_PASSWORD=replace_with_test_database_password
